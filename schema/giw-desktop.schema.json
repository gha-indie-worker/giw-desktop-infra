{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indiebuild.dev/schemas/giw-desktop.schema.json",
  "title": "GIW desktop desired state",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "services"],
  "properties": {
    "version": { "const": 1 },
    "services": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/service" }
    },
    "tunnel": { "$ref": "#/$defs/tunnel" },
    "update": { "$ref": "#/$defs/update" }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 8192 },
          "default": []
        },
        "working_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "env_passthrough": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "default": []
        },
        "env": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "allOf": [
              { "pattern": "^[A-Z_][A-Z0-9_]*$" },
              {
                "not": {
                  "pattern": "(TOKEN|SECRET|PASSWORD|PRIVATE|CREDENTIAL|API_KEY|DATABASE_URL|GH_PAT)"
                }
              }
            ]
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 16384
          },
          "default": {}
        },
        "autostart": { "type": "boolean", "default": false }
      }
    },
    "tunnel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "service_url"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "hostname": { "type": "string", "minLength": 1, "maxLength": 253 },
        "service_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^http://(127\\.0\\.0\\.1|\\[::1\\]):[0-9]{1,5}/?$"
        },
        "autostart": { "type": "boolean", "default": false }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 8192 },
          "default": []
        }
      }
    }
  }
}
